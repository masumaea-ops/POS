# ==============================================================================
# MASUMA POS, ERP & B2B WHOLESALE SYSTEM - PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
VITE_APP_NAME="Masuma Autoparts ERP"
VITE_APP_DESCRIPTION="B2B Wholesale, Counter POS & Auto Garage Operating Suite"
VITE_DEFAULT_LOCALE="en"

# ------------------------------------------------------------------------------
# 2. MYSQL PRODUCTION DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=masuma_db_user
DB_PASSWORD=your_strong_mysql_password_here
DB_NAME=masuma_erp_production
DB_CONNECTION_LIMIT=25
DB_SSL_ENABLED=false

# ------------------------------------------------------------------------------
# 3. CORPORATE IDENTITY & CONTACT DETAILS
# ------------------------------------------------------------------------------
VITE_CORP_NAME="Masuma Auto Parts East Africa Ltd"
VITE_CORP_SHORT_NAME="Masuma"
VITE_CORP_TAGLINE="High Precision Japanese & European Spare Parts"
VITE_CORP_TAX_PIN="P051234567X"
VITE_CORP_PHONE="+254 700 000 000"
VITE_CORP_EMAIL="billing@masuma.co.ke"
VITE_CORP_ADDRESS="Masuma Complex, Commercial St, Industrial Area, Nairobi, Kenya"

# ------------------------------------------------------------------------------
# 4. REGIONAL, CURRENCY & FISCAL SETTINGS (KENYA / EAC)
# ------------------------------------------------------------------------------
VITE_CURRENCY="KES"
VITE_DEFAULT_VAT_RATE=16
VITE_TIMEZONE="Africa/Nairobi"

# ------------------------------------------------------------------------------
# 5. KRA eTIMS FISCAL INTEGRATION (KENYA REVENUE AUTHORITY)
# ------------------------------------------------------------------------------
VITE_ETIMS_ENABLED=true
VITE_ETIMS_SERVER_URL="https://etims.kra.go.ke/api/v1"
VITE_ETIMS_DEVICE_SERIAL="MASUMA-TIMS-NRB-01"
VITE_ETIMS_BRANCH_CODE="HQ-01"
ETIMS_API_KEY="your_kra_etims_api_key_here"

# ------------------------------------------------------------------------------
# 6. MOBILE MONEY & PAYMENT GATEWAYS (M-PESA / TILL / BANK)
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT="production"
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=889900
MPESA_CONSUMER_KEY="your_safaricom_consumer_key"
MPESA_CONSUMER_SECRET="your_safaricom_consumer_secret"
MPESA_PASSKEY="your_safaricom_passkey"
MPESA_CALLBACK_URL="https://erp.masuma.co.ke/api/payments/mpesa/callback"

# ------------------------------------------------------------------------------
# 7. SMS DUNNING & CUSTOMER NOTIFICATIONS
# ------------------------------------------------------------------------------
SMS_PROVIDER="africastalking"
AFRICASTALKING_USERNAME="masuma_nrb"
AFRICASTALKING_API_KEY="your_africastalking_api_key_here"
SMS_SENDER_ID="MASUMA-AUTO"

# ------------------------------------------------------------------------------
# 8. CYBERSECURITY, AUTH & TERMINAL IDLE SHIELD
# ------------------------------------------------------------------------------
VITE_MASTER_PIN_SALT="masuma_corp_secure_salt_2026"
SESSION_TIMEOUT_MINUTES=15
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=60
