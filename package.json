    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.22.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
